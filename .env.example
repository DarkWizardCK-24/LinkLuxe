NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional: named Firestore database (defaults to "(default)")
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=
# Optional: public origin used for status redirects (e.g. https://linkluxe.app)
NEXT_PUBLIC_HOST=
# Local development only: connect to the Firebase emulators (auth 9299, firestore 8280)
NEXT_PUBLIC_USE_EMULATOR=
